# Copie para .env e configure os valores da sua máquina
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/restaurante_uc_hub?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Sao_Paulo
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=COLOQUE_SUA_SENHA_MYSQL

# Gere uma chave aleatória forte. Mantenha-a privada e estável entre reinicializações.
APP_JWT_SECRET=COLOQUE_UMA_CHAVE_ALEATORIA_COM_PELO_MENOS_32_CARACTERES
APP_JWT_EXPIRATION_MINUTES=60

# O primeiro administrador será criado automaticamente se ainda não existir.
APP_ADMIN_EMAIL=admin@restaurante.local
APP_ADMIN_PASSWORD=DEFINA_UMA_SENHA_FORTE

APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
SERVER_PORT=8080
